# Template for the local environment file.
# Copy to `.env` (gitignored) and fill in real values. NEVER commit `.env`.

# --- Extractor service: CampusAI (DTU OpenAI-compatible gateway) ---
CAMPUSAI_API_KEY=your-api-key-here
CAMPUSAI_MODEL=cai
CAMPUSAI_API_URL=https://api.campusai.compute.dtu.dk/v1

# --- Extractor tuning (optional, defaults shown) ---
EXTRACTOR_TEMPERATURE=0.7
SELF_CONSISTENCY_SAMPLES=8
CONSISTENCY_THRESHOLD=0.5
EXTRACTOR_TIMEOUT_SECONDS=60.0

# --- Frontend service: proxy target (optional, defaults shown) ---
PERSON_SERVICE_URL=http://localhost:8000
PERSON_SERVICE_ENDPOINT=/v1/extract-persons
PERSON_SERVICE_TIMEOUT_SECONDS=60.0
